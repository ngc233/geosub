import test from "node:test";
import { readFileSync } from "node:fs";
import assert from "node:assert/strict";
import { countryCanvasRows, countrySaving, countrySummary, type CountryCanvasRow } from "./country-canvas.ts";
import { homepageCountries } from "./homepage-summary.ts";
import { formatPublicDate } from "./public-date.ts";

// Handwritten fictional prices, never a production or canvas export.
const row = (index: number, usd: number | null, usPrice: number | null = 100): CountryCanvasRow => ({
  productSlug: `fictional-${index}`, productName: `Fictional ${index}`, planSlug: "standard", planName: "Standard",
  countryCode: "TR", category: "ai", amount: 999, currency: "TRY", platform: "ios", billingCycle: "monthly",
  priceType: "list_price", quality: "verified", confidence: 90, checkedAt: "2026-11-10T00:00:00Z",
  sourceUrl: "https://apps.apple.com/tr/app/fictional/id123456789", observationId: null, fxDate: "2026-11-10",
  usd, usPrice, difference: usd === null || usPrice === null ? null : Math.round((usd / usPrice - 1) * 100),
});
test("D8 uses unrounded equal-weight median, retains negatives and counts tiny real savings", () => {
  const rows = [200, 150, 99.99, 80, 50, 40].map((price, i) => row(i, price));
  const summary = countrySummary(rows, "TR")!;
  assert.equal(summary.count, 6);assert.equal(summary.cheaper, 4);
  assert.equal(summary.median, ((1 - 99.99 / 100) + (1 - 80 / 100)) / 2);
  assert.equal(summary.best, .6);
  assert.equal(summary.median, homepageCountries(rows as (CountryCanvasRow & { usd: number })[])[0].median);
});
test("fewer than five comparable subscriptions hides the summary", () => {
  assert.equal(countrySummary([1, 2, 3, 4].map((n, i) => row(i, n)), "TR"), null);
  assert.equal(countrySummary([1, 2, 3, 4].map((n, i) => row(i, n)).concat(row(5, null), row(6, 4, null)), "TR"), null);
});
test("missing, nonfinite, zero and negative baselines cannot produce savings", () => {
  for (const value of [null, 0, -1, Infinity, NaN]) {
    assert.equal(countrySaving(row(0, 10, value)), null);assert.equal(countrySaving(row(0, value)), null);
  }
});
test("duplicate same-plan rows do not acquire extra weight or change best savings", () => {
  const rows = [110, 105, 100, 90, 80].map((n, i) => row(i, n));
  assert.deepEqual(countrySummary([...rows, { ...rows[0], usd: 1 }], "TR"), countrySummary(rows, "TR"));
  assert.equal(countrySummary([...rows, { ...row(8, 1), countryCode: "JP" }], "TR")!.count, 5);
});
test("a country can be more expensive overall; negative median must survive", () => {
  const s = countrySummary([105, 110, 120, 130, 140].map((n, i) => row(i, n)), "TR")!;
  assert.equal(s.cheaper, 0);assert.equal(s.median, 1 - 1.2);assert.equal(s.best, 1 - 1.05);
});
test("rows sort by original savings, not rounded difference; FX-missing local prices remain", () => {
  const rows = [row(0, 99.99), row(1, 99.9), row(2, null), row(3, 120)];
  assert.deepEqual(countryCanvasRows(rows).map(x => x.productSlug), ["fictional-1", "fictional-0", "fictional-3", "fictional-2"]);
  assert.equal(countryCanvasRows(rows)[3].amount, 999);assert.equal(countryCanvasRows(rows)[3].planName, "Fictional 2 标准版");
  assert.deepEqual(rows.map(x => x.productSlug), ["fictional-0", "fictional-1", "fictional-2", "fictional-3"]);
});
test("server date labels exactly match the existing formatter across years, offsets and missing values", () => {
  const now = new Date("2026-11-10T00:00:00Z");
  for (const checkedAt of ["2026-11-09T18:00:00Z", "2025-12-31T00:00:00Z", "invalid"]) {
    for (const fxDate of ["2026-11-09", "2025-12-31", "invalid", null]) {
      const input = { ...row(0, 50), checkedAt, fxDate };
      const output = countryCanvasRows([input], now)[0];
      assert.equal(output.checkedAtText, formatPublicDate(checkedAt, now)?.text ?? "");
      assert.equal(output.fxText, fxDate ? formatPublicDate(fxDate, now)?.text ?? "" : null);
      assert.equal(output.usd, input.usd);assert.equal(output.usPrice, input.usPrice);
    }
  }
});
test("cached country font preserves the exact binary and the gated shared swap declaration", () => {
  const sheet = readFileSync(new URL("../app/public-country.css", import.meta.url), "utf8");
  const face = sheet.split("/* V6 cached numeral asset; generated by subset-product-price-font.py. */")[1].trim();
  const encoded = face.match(/url\("data:font\/woff2;base64,([A-Za-z0-9+/=]+)"\)/)!;
  assert.ok(encoded);
  assert.deepEqual(Buffer.from(encoded[1], "base64"), readFileSync(new URL("../assets/fonts/web/geosub-price-numerals-700.woff2", import.meta.url)));
  const original = readFileSync(new URL("../app/public-base.css", import.meta.url), "utf8").split("\n").find(line => line.startsWith("@font-face") && line.includes('font-family:"GeoSub Price Numerals";'));
  assert.match(face, /font-family:"GeoSub Country Numerals";/);
  assert.match(sheet, /--gs-font-price: "GeoSub Country Numerals"/);
  assert.equal(face.replace('font-family:"GeoSub Country Numerals";', 'font-family:"GeoSub Price Numerals";').replace(encoded[0], 'url("../assets/fonts/web/geosub-price-numerals-700.woff2")'), original);
  assert.match(face, /font-display:swap;/);
});
