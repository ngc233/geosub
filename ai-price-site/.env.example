# GeoSub 前端环境变量模板。复制为 .env 后再填写；真实密码、令牌和密钥不要提交到 Git。
# NODE_ENV 由 Next.js 自动设置，LOCALAPPDATA 与 TEMP 由操作系统提供，不应写入项目环境文件。

# 必填；PostgreSQL 连接串，无默认值。示例：postgresql://USER:PASSWORD@localhost:5433/DATABASE
DATABASE_URL=

# 可选；公开站点绝对地址，用于 canonical、sitemap 和分享链接；默认值：https://geosub.org
NEXT_PUBLIC_SITE_URL=https://geosub.org

# 可选；IndexNow 提交密钥，8-128 位字母、数字或短横线。生产环境启用时必填，不要提交真实值。
INDEXNOW_KEY=
# 可选；IndexNow 验证文件地址。默认值：https://geosub.org/indexnow-key.txt
INDEXNOW_KEY_LOCATION=https://geosub.org/indexnow-key.txt
# 可选；IndexNow API 地址。默认值：https://api.indexnow.org/indexnow
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# 可选；产品 SEO 质量门禁，可选 observe 或 enforce；默认值：observe
SEO_PRODUCT_QUALITY_GATE=enforce

# 可选；Directus 服务地址，仅启用 Directus 内容源时填写；默认值：空（禁用）
DIRECTUS_URL=
# 可选；Directus 静态访问令牌，仅在 DIRECTUS_URL 已配置时填写；默认值：空
DIRECTUS_TOKEN=

# 可选；后台会话有效小时数；默认值：24
GEOSUB_ADMIN_SESSION_HOURS=24
# 可选；后台读模型缓存毫秒数，0 表示关闭；默认值：10000
GEOSUB_ADMIN_READ_MODEL_TTL_MS=10000
# 可选；后台工作负载超过该毫秒数时记录慢日志；默认值：750
GEOSUB_ADMIN_SLOW_WORKLOAD_MS=750
# 可选；是否记录全部后台性能日志；默认值：false
GEOSUB_ADMIN_PERFORMANCE_LOG=false
# 按需必填；仅执行数据库 seed 或重置管理员密码时使用；默认值：空
GEOSUB_ADMIN_EMAIL=
# 按需必填；仅执行数据库 seed 或重置管理员密码时使用，至少 14 个字符；默认值：空
GEOSUB_ADMIN_PASSWORD=

# 可选；Web 进程连接 PostgreSQL 时的 application_name；默认值：geosub-web
GEOSUB_DB_APPLICATION_NAME=geosub-web
# 可选；Web 进程数据库连接池上限，允许 2-30；默认值：10
GEOSUB_DB_POOL_MAX=10
# 可选；数据库连接超时毫秒数，允许 1000-30000；默认值：5000
GEOSUB_DB_CONNECTION_TIMEOUT_MS=5000
# 可选；数据库空闲连接超时毫秒数，允许 5000-300000；默认值：30000
GEOSUB_DB_IDLE_TIMEOUT_MS=30000

# 可选；手动采集时用于定位 geosub-backend 的绝对路径；默认值：自动从相邻目录查找
GEOSUB_BACKEND_ROOT=
# 可选；GEOSUB_BACKEND_ROOT 的兼容别名；默认值：自动从相邻目录查找
GEOSUB_BACKEND_DIR=
# 可选；产品 Logo 持久化目录；默认值：生产为 /var/lib/geosub/product-logos，本地为系统临时目录
GEOSUB_LOGO_STORAGE_DIR=

# 可选；App Store 采集器的紧急总开关。设为 false 后不会发出店面请求。
GEOSUB_APP_STORE_COLLECTION_ENABLED=true
# 可选；App Store 实际网络请求的最小间隔（毫秒），另有少量随机抖动。
GEOSUB_APP_STORE_REQUEST_DELAY_MS=1000
# 可选；瞬时失败最大重试次数，默认 2，最多 5。
GEOSUB_APP_STORE_MAX_RETRIES=2
# 可选；成功店面响应缓存分钟数，默认 720（12 小时）。
GEOSUB_APP_STORE_CACHE_TTL_MINUTES=720
# 可选；App Store 响应缓存目录。本地留空时使用系统临时目录。
GEOSUB_APP_STORE_CACHE_DIR=
# 可选；透明标识采集器身份，不应伪装成普通浏览器。
GEOSUB_APP_STORE_USER_AGENT=GeoSubPriceResearch/2.8 (+https://geosub.org/data-sources; contact: https://geosub.org/zh/contact)

# 可选；汇率同步基准币种；默认值：USD
GEOSUB_FX_BASE=USD
# 可选；在内置币种列表之外追加的逗号分隔币种代码；默认值：空
GEOSUB_FX_QUOTES=
# 可选；汇率新鲜度检查允许的最大小时数；默认值：18
GEOSUB_MAX_EXCHANGE_RATE_AGE_HOURS=18
# 可选；汇率 cron 的主密钥，生产环境调用同步接口时应设置；默认值：空
CRON_SECRET=
# 可选；CRON_SECRET 的兼容别名；默认值：空
EXCHANGE_RATE_CRON_SECRET=

# 可选；价格质量检查限定的逗号分隔产品 slug；默认值：空（检查全部）
GEOSUB_PRICE_CHECK_PRODUCTS=
# 可选；正式订阅价格允许的最低美元值；默认值：1
GEOSUB_MIN_PUBLISHED_SUBSCRIPTION_USD=1
# 可选；运行中的采集任务超过多少分钟视为卡住；默认值：45
GEOSUB_MAX_COLLECTOR_RUNNING_MINUTES=45
# 可选；正式价格允许的最大未更新天数；默认值：14
GEOSUB_MAX_PUBLISHED_PRICE_AGE_DAYS=14
# 可选；App Store 产品最近成功采集允许的最大天数；默认值：8
GEOSUB_MAX_APP_STORE_PRODUCT_RUN_AGE_DAYS=8
# 可选；待处理异常占比告警阈值，范围 0-1；默认值：0.35
GEOSUB_MAX_PENDING_ANOMALY_RATIO=0.35

# 可选；原始分析事件保留天数；默认值：180
GEOSUB_EVENT_RETENTION_DAYS=180

# 可选；每日运营通知的 HTTPS Webhook 地址；默认值：空（禁用）
GEOSUB_OPERATIONS_WEBHOOK_URL=
# 可选；Webhook 允许的逗号分隔主机名，配置 URL 时必须同时填写；默认值：空
GEOSUB_OPERATIONS_WEBHOOK_ALLOWED_HOSTS=
# 可选；Webhook Bearer Token；默认值：空
GEOSUB_OPERATIONS_WEBHOOK_TOKEN=

# 可选；World Bank 同步脚本访问本地 PostgreSQL 时使用的容器名；默认值：geosub-postgres
GEOSUB_DB_CONTAINER=geosub-postgres
# 可选；World Bank 同步脚本使用的 PostgreSQL 用户；默认值：geosub_admin
GEOSUB_DB_USER=geosub_admin
# 可选；World Bank 同步脚本使用的数据库名；默认值：geosub_app
GEOSUB_DB_NAME=geosub_app
# 可选；World Bank API 请求超时毫秒数；默认值：12000
WORLD_BANK_TIMEOUT_MS=12000
