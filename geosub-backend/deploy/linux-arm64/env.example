# GeoSub Linux ARM64 deployment environment

# Project paths
GEOSUB_BACKEND_DIR=/opt/geosub/geosub-backend
GEOSUB_FRONTEND_DIR=/opt/geosub/ai-price-site
GEOSUB_GIT_BRANCH=main
GEOSUB_SKIP_GIT_PULL=false

# Docker / database
GEOSUB_DB_CONTAINER=geosub-postgres
GEOSUB_DB_NAME=geosub_app
GEOSUB_DB_USER=geosub_admin

# Next.js database pool. Keep this bounded because collectors and Directus
# connect to the same PostgreSQL instance through separate processes.
GEOSUB_DB_APPLICATION_NAME=geosub-web
GEOSUB_DB_POOL_MAX=10
GEOSUB_DB_CONNECTION_TIMEOUT_MS=5000
GEOSUB_DB_IDLE_TIMEOUT_MS=30000

# Backups
GEOSUB_BACKUP_DIR=/opt/geosub/backups
GEOSUB_BACKUP_KEEP_DAYS=14
GEOSUB_MAX_BACKUP_AGE_HOURS=30
# Optional mounted second disk or remote filesystem.
GEOSUB_BACKUP_MIRROR_DIR=

# Admin security
GEOSUB_ADMIN_SESSION_HOURS=24
GEOSUB_ADMIN_SLOW_WORKLOAD_MS=750
# Coalesce repeated heavy admin reads while keeping operational data near-real-time.
GEOSUB_ADMIN_READ_MODEL_TTL_MS=10000
# Set to true temporarily when profiling every dashboard workload.
GEOSUB_ADMIN_PERFORMANCE_LOG=false

# Raw analytics are removed only after daily aggregates exist.
GEOSUB_EVENT_RETENTION_DAYS=180

# Collectors
GEOSUB_COUNTRIES=US,CA,JP,PH
GEOSUB_PRODUCT_SLUG=chatgpt
GEOSUB_COLLECTOR_JOB_LIMIT=5
# Emergency brake. Set to false to stop all App Store storefront requests
# without disabling the collector queue or editing scheduled tasks.
GEOSUB_APP_STORE_COLLECTION_ENABLED=true
# Minimum delay between actual storefront requests. A small random jitter is
# added automatically. This does not change the systemd timer frequency.
GEOSUB_APP_STORE_REQUEST_DELAY_MS=1000
# Retry transient timeouts, HTTP 429, and server errors with exponential backoff.
GEOSUB_APP_STORE_MAX_RETRIES=2
# Reuse successful storefront responses for 12 hours during duplicate/manual runs.
GEOSUB_APP_STORE_CACHE_TTL_MINUTES=720
GEOSUB_APP_STORE_CACHE_DIR=/var/lib/geosub/app-store-cache
# Transparent collector identity. Keep the public data-source and contact URLs.
GEOSUB_APP_STORE_USER_AGENT=GeoSubPriceResearch/2.8 (+https://geosub.org/data-sources; contact: https://geosub.org/zh/contact)

# Exchange rates
GEOSUB_EXCHANGE_RATE_BASE=USD
GEOSUB_EXCHANGE_RATE_QUOTES=AED,ARS,AUD,BRL,CAD,CHF,CLP,CNY,COP,DKK,EGP,EUR,GBP,HKD,IDR,ILS,INR,JPY,KES,KRW,MXN,MYR,NGN,NOK,NZD,PHP,PKR,PLN,SAR,SEK,SGD,THB,TRY,TWD,VND,ZAR
GEOSUB_MAX_EXCHANGE_RATE_AGE_HOURS=18
# Keep legacy until three distinct scheduled shadow cycles pass.
GEOSUB_EXCHANGE_RATE_RUNTIME=legacy
GEOSUB_EXCHANGE_RATE_SHADOW_VERIFY=0

# Post-deploy health check
GEOSUB_WEB_HEALTH_URL=http://127.0.0.1:3000/api/health
GEOSUB_PUBLIC_HEALTH_URL=https://geosub.org/api/health

# Discovery scanner
GEOSUB_DISCOVERY_SCAN_LIMIT=20

# Browser rendering
# Leave empty to auto-detect /usr/bin/chromium, /usr/bin/chromium-browser, etc.
CHROME_PATH=

# Growth data shadow collection (read-only; keep disabled until credentials are configured).
GEOSUB_GROWTH_BING_ENABLED=false
GEOSUB_GROWTH_OUTPUT_DIR=/var/lib/geosub/growth
GEOSUB_BING_SITE_URL=https://geosub.org/
GEOSUB_BING_API_BASE_URL=https://www.bing.com/webmaster/api.svc/json
GEOSUB_BING_CLIENT_ID=
GEOSUB_BING_CLIENT_SECRET=
GEOSUB_BING_REFRESH_TOKEN=
GEOSUB_GOOGLE_SITE_URL=https://geosub.org/
GEOSUB_GOOGLE_API_BASE_URL=https://www.googleapis.com/webmasters/v3
GEOSUB_GOOGLE_CLIENT_ID=
GEOSUB_GOOGLE_CLIENT_SECRET=
GEOSUB_GOOGLE_REFRESH_TOKEN=
GEOSUB_GOOGLE_START_DATE=
GEOSUB_GOOGLE_END_DATE=

# Runtime tuning for an 8 GB / 6 vCPU ARM server
NODE_OPTIONS=--max-old-space-size=1536

# Upgrade behavior
GEOSUB_RUN_CONTENT_MIGRATIONS=false
