[Unit]
Description=GeoSub queued collector job worker
Wants=docker.service
After=docker.service network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/geosub/geosub.env
Environment=GEOSUB_COLLECTOR_LOCK_DIR=/run/geosub
WorkingDirectory=/opt/geosub/geosub-backend
ExecStart=/usr/bin/env node /opt/geosub/geosub-backend/scripts/collector-queue-worker.mjs
Restart=always
RestartSec=5
TimeoutStopSec=60
User=geosub
Group=geosub
RuntimeDirectory=geosub
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
MemoryMax=1800M
CPUQuota=120%

[Install]
WantedBy=multi-user.target
