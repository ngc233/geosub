# Copy placeholders ONLY into /etc/geosub/task-heartbeats.env (root:root, 0600).
# The product owner creates FOUR different HetrixTools Cron Job monitors.
# Paste real URLs on the server only. Never commit them or put them in geosub.env.
# Empty means no request and monitoring is NOT active.
GEOSUB_COLLECTOR_HEARTBEAT_URL=
GEOSUB_BACKUP_HEARTBEAT_URL=
GEOSUB_PRICE_PIPELINE_HEARTBEAT_URL=
GEOSUB_EXCHANGE_RATE_HEARTBEAT_URL=
